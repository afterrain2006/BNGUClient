<?xml version="1.0" encoding="UTF-8"?>
<HUDPanel id="module-status">
  <title>模块状态</title>
  <description>显示视频、MQTT 连接及 UDP 图传帧率</description>
  
  <!-- 初始位置配置 -->
  <position>
    <bottom>26px</bottom>
    <left>228px</left>
  </position>
  
  <!-- 初始大小配置 -->
  <size>
    <width>320px</width>
    <height>auto</height>
    <minWidth>280px</minWidth>
    <minHeight>150px</minHeight>
    <maxWidth>450px</maxWidth>
    <maxHeight>400px</maxHeight>
  </size>
  
  <!-- 功能配置 -->
  <options>
    <resizable>true</resizable>
    <defaultTeam>inherit</defaultTeam>
    <defaultVisible>false</defaultVisible>
  </options>
  
  <!-- 显示内容配置 -->
  <content>
    <component>ModuleStatus</component>
    <fields>
      <field name="camera" label="视频" type="status" />
      <field name="communication" label="MQTT" type="status" />
      <field name="fps" label="图传帧率" type="number" />
    </fields>
  </content>
</HUDPanel>
