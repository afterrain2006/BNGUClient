{
  "name": "bnguclient",
  "private": true,
  "version": "1.0.0",
  "author": "BNGUClient contributors",
  "contributors": ["JNU-Shark"],
  "type": "module",
  "scripts": {
    "typecheck": "vue-tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "check": "npm run typecheck && npm test && npm run verify:mqtt-proto",
    "predev": "npm run generate:mqtt-proto",
    "dev": "vite",
    "prebuild": "npm run generate:mqtt-proto",
    "build": "vite build",
    "build:desktop": "tauri build --no-bundle",
    "build:installer": "tauri build --bundles nsis",
    "build:ffmpeg:minimal": "powershell -ExecutionPolicy Bypass -File scripts/build-ffmpeg-minimal.ps1",
    "build:linux": "bash scripts/build-linux-client.sh",
    "generate:mqtt-proto": "node scripts/generate-mqtt-proto-json.mjs",
    "verify:mqtt-proto": "node scripts/verify-mqtt-proto.mjs",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "js-yaml": "^4.1.1",
    "long": "^5.3.2",
    "pinia": "^3.0.4",
    "protobufjs": "^8.0.1",
    "vite-plugin-node-polyfills": "^0.26.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^25.5.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "esbuild": "^0.25.12",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vue-tsc": "^2.1.10"
  }
}
